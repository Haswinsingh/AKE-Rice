# ==============================================================================
# AKE RICE CLIENT - ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# API Base URL
# - In local development: Leave blank or set to '/api' (Vite dev proxy forwards to http://localhost:5000)
# - In production with separate backend (e.g. Render, Railway, AWS):
#   Set to your full backend API endpoint, e.g. https://api.akerice.com/api
# - In production on Vercel with same-domain rewrites: Leave as '/api'
VITE_API_URL=/api
