# ==============================================================================
# AKE RICE SERVER - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and replace placeholder values with your real credentials.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# Set your production MongoDB Atlas URI or leave blank for local MongoDB.
# If MongoDB is not reachable, the server gracefully falls back to local JSON data store.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/ake_rice_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Initial Super Admin Bootstrap (Created automatically on initial server boot)
INITIAL_ADMIN_NAME=Kavin
INITIAL_ADMIN_MOBILE=8489107668
INITIAL_ADMIN_EMAIL=kaviyansellappan15@gmail.com
DEFAULT_ADMIN_USER=Kavin
DEFAULT_ADMIN_PASS=AshokKavinRice
DEFAULT_ADMIN_MOBILE=8489107668

# Email OTP Authentication Configuration (Gmail SMTP with Nodemailer)
OTP_PROVIDER=email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_google_app_password
OTP_LENGTH=4
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MOCK=false

# Legacy SMS Provider Settings (Optional / Replaced by Email OTP)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_template_id
MSG91_SENDER_ID=AKERCE
MSG91_OTP_URL=https://control.msg91.com/api/v5/otp

# Payment & UPI Configuration
UPI_ID=kaviyansellappan15@oksbi
UPI_PAYEE_NAME=AKE Rice
UPI_PHONE=9176049099
WHATSAPP_NUMBER=919176049099

# Cloudinary File Storage (Optional - falls back to local uploads if not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration for Automated Weekly Reports
ADMIN_EMAIL=kaviyansellappan15@gmail.com
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_google_app_password
